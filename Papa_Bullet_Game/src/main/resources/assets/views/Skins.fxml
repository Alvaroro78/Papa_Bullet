<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Pantalla de Skins: mismo paisaje que el menú; en el panel, la vista previa grande,
     el nombre de la skin y las flechas. La skin queda elegida apenas se cambia. -->

<StackPane prefHeight="600" prefWidth="800" styleClass="menu-root" stylesheets="@menu.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.SkinsController">

    <Canvas fx:id="background" height="600" width="800" />

    <VBox alignment="TOP_CENTER" spacing="24" translateY="40">

        <Text fill="WHITE" styleClass="title-text" text="SKINS" />

        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="420" spacing="16" styleClass="menu-panel">

            <Canvas fx:id="preview" height="200" width="200" />

            <HBox alignment="CENTER" spacing="18">
                <Button onAction="#onPrevClicked" prefHeight="56" prefWidth="64" styleClass="wood-button">
                    <graphic><Text styleClass="wood-text" text="&lt;" /></graphic>
                </Button>
                <Text fx:id="skinName" styleClass="hud-text" text="CLÁSICO" />
                <Button onAction="#onNextClicked" prefHeight="56" prefWidth="64" styleClass="wood-button">
                    <graphic><Text styleClass="wood-text" text="&gt;" /></graphic>
                </Button>
            </HBox>

            <Button onAction="#onBackClicked" prefHeight="64" prefWidth="300" styleClass="wood-button">
                <graphic><Text styleClass="wood-text" text="VOLVER" /></graphic>
            </Button>
        </VBox>
    </VBox>

</StackPane>
