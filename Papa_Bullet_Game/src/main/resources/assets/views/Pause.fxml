<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<!-- Menú de pausa: NO es una pantalla nueva, es una capa que se pone ENCIMA de Game.
     El fondo es negro semitransparente, así el juego se sigue viendo detrás. -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="control.PauseController"
           stylesheets="@menu.css"
           styleClass="pause-overlay">

    <VBox alignment="CENTER" spacing="40">

        <Text styleClass="title-text" text="PAUSA"/>

        <VBox alignment="CENTER" spacing="0" maxWidth="300">

            <Button fx:id="resumeButton" styleClass="wood-button"
                    onAction="#onResumeClicked"
                    prefWidth="300" prefHeight="70">
                <graphic>
                    <Text styleClass="wood-text" text="CONTINUAR"/>
                </graphic>
            </Button>

            <HBox alignment="CENTER" spacing="200">
                <Region styleClass="rope"/>
                <Region styleClass="rope"/>
            </HBox>

            <!-- "Salir del juego" del diagrama: vuelve al Main Menu -->
            <Button fx:id="exitButton" styleClass="wood-button"
                    onAction="#onExitClicked"
                    prefWidth="300" prefHeight="70">
                <graphic>
                    <Text styleClass="wood-text" text="SALIR"/>
                </graphic>
            </Button>

        </VBox>
    </VBox>

</StackPane>
