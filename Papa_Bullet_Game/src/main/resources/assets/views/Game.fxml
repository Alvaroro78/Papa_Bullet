<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<!-- Vista Game: contenedor donde viven todos los niveles.
     Capas (de atrás hacia adelante): Canvas del juego -> HUD -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="root"
           fx:controller="control.GameController"
           stylesheets="@menu.css"
           styleClass="game-root"
           prefWidth="800" prefHeight="600">

    <!-- Capa 1: el juego. GameController dibuja aquí las baldosas y todas las entidades. -->
    <Canvas fx:id="canvas" width="800" height="600"
            StackPane.alignment="TOP_LEFT"/>

    <!-- Capa 2: HUD, siempre encima -->
    <!-- Arriba a la izquierda dibuja el Hud (1P, vida, armas); el nombre del nivel va al centro -->
    <Text fx:id="levelLabel" styleClass="hud-text" text="NIVEL 1"
          StackPane.alignment="TOP_CENTER" translateY="22"/>

    <Button fx:id="pauseButton" styleClass="wood-button"
            onAction="#onPauseClicked"
            prefWidth="110" prefHeight="50"
            StackPane.alignment="TOP_RIGHT" translateX="-16" translateY="16">
        <graphic>
            <Text styleClass="hud-text" text="II"/>
        </graphic>
    </Button>

</StackPane>
